# Public OMS API origin. Local dev leaves this empty and uses the Vite /api proxy.
# A deployed frontend still needs this (or a reverse proxy) before /api calls leave the page origin.
VITE_OMS_API_BASE_URL=

# OIDC public client. Defaults match mock-tsf on localhost. Do not point authority at the Vite /tsf-idp proxy.
VITE_OIDC_AUTHORITY=http://localhost:8090/tsf-idp
VITE_OIDC_CLIENT_ID=oms-web
# Leave this unset. The redirect URI defaults to window.location.origin + "/".
# A fixed http://localhost:5173/ does not match a tab opened at http://127.0.0.1:5173/.
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/
