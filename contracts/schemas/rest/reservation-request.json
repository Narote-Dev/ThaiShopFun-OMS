{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkout_id",
    "tsf_shop_id",
    "items"
  ],
  "properties": {
    "checkout_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "tsf_shop_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "listing_sku_id",
          "qty"
        ],
        "properties": {
          "listing_sku_id": {
            "type": "string",
            "minLength": 1
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
