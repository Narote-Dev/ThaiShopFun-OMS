{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error",
    "message",
    "trace_id"
  ],
  "properties": {
    "error": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string"
    },
    "trace_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    }
  }
}
