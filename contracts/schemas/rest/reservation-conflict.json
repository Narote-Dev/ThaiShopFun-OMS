{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error",
    "items"
  ],
  "properties": {
    "error": {
      "type": "string",
      "enum": [
        "OUT_OF_STOCK"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "listing_sku_id",
          "requested",
          "available"
        ],
        "properties": {
          "listing_sku_id": {
            "type": "string",
            "minLength": 1
          },
          "requested": {
            "type": "integer",
            "minimum": 0
          },
          "available": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
