{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reservation_id",
    "expires_at",
    "enforced",
    "items"
  ],
  "properties": {
    "reservation_id": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "enforced": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "listing_sku_id",
          "qty",
          "enforced"
        ],
        "properties": {
          "listing_sku_id": {
            "type": "string",
            "minLength": 1
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "enforced": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
