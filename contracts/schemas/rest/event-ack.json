{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "event_id"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "duplicate"
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
