{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule", "status", "details", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "rule": { "type": "string" },
          "status": { "enum": ["OPEN", "ACK", "RESOLVED"] },
          "order_id": { "type": ["string", "null"], "format": "uuid" },
          "external_order_id": { "type": ["string", "null"] },
          "details": { "type": "object" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
