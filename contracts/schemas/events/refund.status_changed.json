{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "refund_id",
    "status",
    "amount",
    "currency"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "refund_id": {
      "type": "string",
      "minLength": 1
    },
    "return_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  }
}
