{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "return_id",
    "decision"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "return_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REJECTED"
      ]
    }
  }
}
