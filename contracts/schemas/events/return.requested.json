{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "return_id",
    "type",
    "reason",
    "lines"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "return_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "RETURN",
        "RTS"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_id",
          "qty"
        ],
        "properties": {
          "line_id": {
            "type": "string",
            "minLength": 1
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
