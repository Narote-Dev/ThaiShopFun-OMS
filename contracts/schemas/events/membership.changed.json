{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tier",
    "status",
    "ent_ver"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "GRACE",
        "SUSPENDED"
      ]
    },
    "ent_ver": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
