{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "status"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "UNPAID",
        "PENDING",
        "PAID",
        "PARTIALLY_REFUNDED",
        "REFUNDED",
        "FAILED"
      ]
    }
  }
}
