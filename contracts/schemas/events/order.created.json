{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "reservation_id",
    "payment_method",
    "payment_expires_at",
    "currency",
    "totals",
    "recipient",
    "ship_by",
    "lines"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "reservation_id": {
      "type": "string",
      "minLength": 1,
      "description": "Checkout reservation_group_id from POST /internal/v1/inventory/reservations. TSF must pass the reservation_id from the checkout response whenever any item has enforced=true (including mixed CONTROL carts where top-level enforced=false), DELETE it on abandon, and may pass a reservation_id that holds nothing when nothing was enforced; OMS treats an unknown id or a group that holds nothing as nothing to adopt and reserves mapped lines fresh."
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "PREPAID",
        "COD"
      ]
    },
    "payment_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subtotal",
        "shipping_fee",
        "discount",
        "grand_total"
      ],
      "properties": {
        "subtotal": {
          "type": "number",
          "minimum": 0
        },
        "shipping_fee": {
          "type": "number",
          "minimum": 0
        },
        "discount": {
          "type": "number",
          "minimum": 0
        },
        "grand_total": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "phone",
        "address"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phone": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line1",
            "district",
            "province",
            "postcode"
          ],
          "properties": {
            "line1": {
              "type": "string",
              "minLength": 1
            },
            "district": {
              "type": "string",
              "minLength": 1
            },
            "province": {
              "type": "string",
              "minLength": 1
            },
            "postcode": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "ship_by": {
      "type": "string",
      "format": "date-time"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_id",
          "listing_sku_id",
          "seller_sku",
          "name",
          "qty",
          "unit_price"
        ],
        "properties": {
          "line_id": {
            "type": "string",
            "minLength": 1
          },
          "listing_sku_id": {
            "type": "string",
            "minLength": 1
          },
          "seller_sku": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
