{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "PREPAID",
        "COD"
      ]
    }
  }
}
