{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "status",
    "carrier",
    "tracking_no",
    "shipped_at"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "carrier": {
      "type": "string",
      "minLength": 1
    },
    "tracking_no": {
      "type": "string",
      "minLength": 1
    },
    "shipped_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
