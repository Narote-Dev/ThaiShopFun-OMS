{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "tsf_shop_id",
    "aggregate_id",
    "aggregate_version",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "event_type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._]+$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "tsf_shop_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "object"
    }
  }
}
