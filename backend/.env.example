# Local defaults. Copy to a shell or .env if you want to override them.
# Do not commit real passwords, HMAC keys, or JWKS material.
#
# DATABASE_USERNAME is the dev-only bootstrap superuser (docker-compose POSTGRES_USER).
# Flyway V1 uses it to create roles, then makes oms_migrator the table owner.
# This login bypasses row-level security. oms_app is not the app login until T03.
# oms_migrator / oms_app passwords are docker-compose env vars (OMS_*_PASSWORD),
# dev-only defaults oms_migrator and oms_app. oms_maint is NOLOGIN.
DATABASE_URL=jdbc:postgresql://localhost:5432/oms
DATABASE_USERNAME=oms
DATABASE_PASSWORD=oms
PORT=8080

# Railway Postgres injects a postgresql:// URL. The app rewrites that to JDBC.
# Later tasks add these in the Railway dashboard. Leave them unset locally.
# TSF_JWKS_URI=
# OMS_INTERNAL_HMAC_SECRET=
