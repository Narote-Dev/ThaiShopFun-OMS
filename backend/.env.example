# Local defaults. Copy to a shell or .env if you want to override them.
# Do not commit real passwords, HMAC keys, or JWKS material.
#
# DATABASE_USERNAME is the runtime login: oms_app (NOBYPASSRLS).
# Dev-only password, same default as docker-compose OMS_APP_PASSWORD. Not a real secret.
# FLYWAY_USER is the dev-only bootstrap superuser. It bypasses RLS. Flyway only.
# oms_maint is NOLOGIN. Do not put passwords in a Flyway migration.
DATABASE_URL=jdbc:postgresql://localhost:5432/oms
DATABASE_USERNAME=oms_app
DATABASE_PASSWORD=oms_app
FLYWAY_USER=oms
FLYWAY_PASSWORD=oms
PORT=8080

# User JWT: aud=oms. Service JWT for /internal/**: aud=oms-internal.
# The local Spring profile already points the issuer and JWKS at mock-tsf.
# Uncomment the issuer only when you are not using that profile.
# Local option: OMS_JWT_ISSUER=http://localhost:8090/tsf-idp
OMS_JWT_AUDIENCE=oms
OMS_JWT_INTERNAL_AUDIENCE=oms-internal
# TSF_JWKS_URI=http://localhost:8090/tsf-idp/.well-known/jwks.json
# OMS_JWKS_URI=
# TSF_OMS_EVENTS_URL=http://localhost:8090/internal/v1/oms-events
# OMS_OUTBOX_WEBHOOK_SECRET=
# OMS_INBOX_HMAC_SECRETS=
