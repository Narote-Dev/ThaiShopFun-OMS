# Local defaults. Copy to a shell or .env if you want to override them.
# Do not commit real passwords, HMAC keys, or JWKS material.
DATABASE_URL=jdbc:postgresql://localhost:5432/oms
DATABASE_USERNAME=oms
DATABASE_PASSWORD=oms
PORT=8080

# Railway Postgres injects a postgresql:// URL. The app rewrites that to JDBC.
# Later tasks add these in the Railway dashboard. Leave them unset locally.
# TSF_JWKS_URI=
# OMS_INTERNAL_HMAC_SECRET=
